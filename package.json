{
  "name": "mobistuff",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "optimize-images": "node scripts/optimizeImages.mjs",
    "generate-mma-catalog": "node scripts/generateMmaCatalog.mjs",
    "sync-mma": "node scripts/syncMmaProducts.mjs",
    "recalc-mma-prices": "node scripts/recalcMmaPrices.mjs",
    "recalc-glass-prices": "MMA_RECALC_GLASS=1 node scripts/recalcMmaPrices.mjs",
    "normalize-brands": "dotenv -e .env.local -- ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/normalizeBrands.ts",
    "mobile:start": "npm run start --workspace=MobistuffMobile",
    "mobile:ios": "npm run ios --workspace=MobistuffMobile",
    "mobile:android": "npm run android --workspace=MobistuffMobile",
    "mobile:lint": "npm run lint --workspace=MobistuffMobile",
    "mobile:pod-install": "cd apps/mobile/ios && bundle exec pod install",
    "mobile:icons": "node scripts/generate-app-icons.mjs",
    "export-catalog-tree": "npx tsx scripts/exportCatalogTree.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.19",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.1",
    "lucide-react": "^0.515.0",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.1",
    "multer": "^2.0.1",
    "next": "^15.5.18",
    "nodemailer": "^7.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-slick": "^0.30.3",
    "react-toastify": "^11.0.5",
    "sharp": "^0.34.5",
    "slick-carousel": "^1.8.1",
    "slugify": "^1.6.6",
    "transliteration": "^2.3.5"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-slick": "^0.23.13",
    "dotenv-cli": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.18",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
