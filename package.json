{
  "name": "mobistuff",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "admin": "node scripts/admin-login.mjs",
    "optimize-images": "node scripts/optimizeImages.mjs",
    "generate-mma-catalog": "node scripts/generateMmaCatalog.mjs",
    "sync-mma": "node scripts/syncMmaProducts.mjs",
    "recalc-mma-prices": "node scripts/recalcMmaPrices.mjs",
    "recalc-glass-prices": "MMA_RECALC_GLASS=1 node scripts/recalcMmaPrices.mjs",
    "normalize-brands": "dotenv -e .env.local -- ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/normalizeBrands.ts",
    "mobile:start": "npm run start --workspace=MobistuffMobile",
    "mobile:ios": "npm run ios --workspace=MobistuffMobile",
    "mobile:android": "npm run android --workspace=MobistuffMobile",
    "mobile:test": "npm run test --workspace=MobistuffMobile",
    "mobile:test:e2e": "npm run test:e2e --workspace=MobistuffMobile",
    "mobile:pod-install": "cd apps/mobile/ios && bundle exec pod install",
    "mobile:icons": "node scripts/generate-app-icons.mjs",
    "mobile:screenshots": "node scripts/resize-app-store-screenshots.mjs",
    "export-catalog-tree": "npx tsx scripts/exportCatalogTree.mjs"
  },
  "dependencies": {
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.1",
    "lucide-react": "^0.515.0",
    "mongodb": "^6.17.0",
    "mongoose": "^8.24.10",
    "multer": "^2.4.1",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-slick": "^0.30.3",
    "react-toastify": "^11.0.5",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "slick-carousel": "^1.8.1",
    "slugify": "^1.6.6",
    "transliteration": "^2.3.5"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "metro": "0.84.6",
    "metro-babel-transformer": "0.84.6",
    "metro-cache": "0.84.6",
    "metro-cache-key": "0.84.6",
    "metro-config": "0.84.6",
    "metro-core": "0.84.6",
    "metro-file-map": "0.84.6",
    "metro-minify-terser": "0.84.6",
    "metro-resolver": "0.84.6",
    "metro-runtime": "0.84.6",
    "metro-source-map": "0.84.6",
    "metro-symbolicate": "0.84.6",
    "metro-transform-plugins": "0.84.6",
    "metro-transform-worker": "0.84.6",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-doctor": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native-community/cli-platform-apple": "20.2.0",
    "@react-native-community/cli-config-android": "20.2.0",
    "@react-native-community/cli-config": "20.2.0",
    "@react-native-community/cli-tools": "20.2.0",
    "@react-native-community/cli-clean": "20.2.0",
    "@react-native-community/cli-server-api": "20.2.0",
    "@react-native-community/cli-types": "20.2.0",
    "@react-native-community/cli-config-apple": "20.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-slick": "^0.23.13",
    "dotenv-cli": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
